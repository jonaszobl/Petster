# Railway backend
NODE_ENV=development
PORT=8787
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2
DATABASE_URL=

# Use "development" only locally. Railway must use "supabase".
AUTH_MODE=development
SUPABASE_URL=https://your-project.supabase.co
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:4173,https://*.lovable.app,https://your-production-domain.example

# Cost and abuse protection
MONTHLY_GENERATION_LIMIT=10
MONTHLY_IMAGE_LIMIT=40
MAX_VARIANTS=4
REQUESTS_PER_MINUTE=4

# Local Vite frontend
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_API_BASE_URL=
